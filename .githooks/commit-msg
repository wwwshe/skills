#!/usr/bin/env bash
set -euo pipefail

msg_file="$1"
first_line="$(sed -n '1p' "$msg_file")"

if [[ -z "${first_line// }" ]]; then
  echo "커밋 메시지 첫 줄이 비어 있습니다."
  exit 1
fi

commit_type_regex='^(feat|fix|docs|refactor|chore|test|release)(\([a-z0-9._-]+\))?: .+'

if ! [[ "$first_line" =~ $commit_type_regex ]]; then
  echo "커밋 메시지 형식이 올바르지 않습니다."
  echo "형식: <type>: <한글 설명> 또는 <type>(scope): <한글 설명>"
  echo "허용 type: feat, fix, docs, refactor, chore, test, release"
  echo "현재: $first_line"
  exit 1
fi

if ! [[ "$first_line" =~ [가-힣] ]]; then
  echo "커밋 메시지 첫 줄에는 한글이 최소 1자 이상 포함되어야 합니다."
  echo "현재: $first_line"
  exit 1
fi

exit 0
