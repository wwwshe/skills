#!/usr/bin/env bash
set -euo pipefail

branch="$(git symbolic-ref --quiet --short HEAD || true)"

# detached HEAD 등 예외 상황은 검사하지 않음
if [[ -z "$branch" ]]; then
  exit 0
fi

if [[ "$branch" =~ ^(main|develop)$ ]]; then
  exit 0
fi

if [[ "$branch" =~ ^(feature|release|hotfix)/[a-z0-9._-]+$ ]]; then
  exit 0
fi

echo "브랜치명이 GitFlow 규칙과 맞지 않습니다: $branch"
echo "허용: main, develop, feature/*, release/*, hotfix/*"
exit 1
